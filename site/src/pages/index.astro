---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const install = 'curl -fsSL https://raw.githubusercontent.com/drslid/DuckCatMine/v0.2.0-alpha.1/install.sh | sudo bash';
const url = 'https://drslid.github.io/DuckCatMine/';
const schema = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication',
  name: 'DuckCatMine', applicationCategory: 'UtilitiesApplication', operatingSystem: 'Linux, Docker',
  url, softwareVersion: '0.2.0-alpha.1', license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  codeRepository: 'https://github.com/drslid/DuckCatMine',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  description: 'Une stack Minecraft Java auto-hébergée avec panneau visuel, carte, chat et installation Docker guidée.',
};
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>DuckCatMine — Votre serveur Minecraft, simplement.</title>
  <meta name="description" content="Créez votre serveur Minecraft Java entre amis. Panneau visuel sur mobile, carte en direct, skins, inventaires et sauvegardes. Docker, DuckDNS ou votre domaine. Gratuit et open source." />
  <meta name="robots" content="index,follow" /><link rel="canonical" href={url} />
  <meta property="og:title" content="DuckCatMine — Votre serveur Minecraft, simplement." />
  <meta property="og:description" content="Jouez ensemble. Gardez la main sur votre monde. Découvrez la démo et installez votre stack Docker." />
  <meta property="og:type" content="website" /><meta property="og:url" content={url} />
  <meta property="og:image" content={`${url}app-icon-512.png`} /><meta name="twitter:card" content="summary" />
  <meta name="theme-color" content="#111b16" />
  <link rel="icon" href={`${base}/logo.svg`} type="image/svg+xml" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <a class="skip" href="#contenu">Aller au contenu</a>
  <header><a class="brand" href={`${base}/`}><img src={`${base}/logo.svg`} alt="" width="36" height="36" />DuckCatMine<span class="alpha">alpha</span></a>
    <nav aria-label="Navigation"><a href={`${base}/guides/decouvrir/`}>Le guide</a><a href="https://github.com/drslid/DuckCatMine">GitHub ↗</a><a class="nav-cta" href={`${base}/demo/`}>Essayer la démo <span>↗</span></a></nav>
  </header>
  <main id="contenu">
    <section class="hero">
      <div class="intro"><p class="eyebrow"><span></span> VOTRE MONDE. VOS AMIS. VOS RÈGLES.</p>
        <h1>Moins d’admin.<br />Plus d’<em>aventures.</em></h1>
        <p class="lead">Un serveur Minecraft à vous. Une interface claire pour le faire vivre, depuis votre ordinateur ou votre téléphone.</p>
        <div class="actions"><a class="button primary" href={`${base}/demo/`}>Explorer la démo <span>↗</span></a><a class="button secondary" href="#installer">Installer mon serveur <span>↓</span></a></div>
        <p class="fine">Gratuit et open source · Minecraft Java · Docker<br />Le VPS et les comptes Minecraft restent à votre charge.</p>
      </div>
      <figure class="hero-screen"><div class="browser-bar"><span>● ● ●</span><small>Votre espace d’administration</small><span>↗</span></div><img src={`${base}/screens/desktop-home.jpg`} alt="Le tableau d’accueil DuckCatMine : joueurs connectés, accès au monde et actions rapides." width="1440" height="1000" fetchpriority="high" /><figcaption>Vraie interface, données fictives. Essayez-la librement.</figcaption></figure>
    </section>
    <div class="feature-strip"><span>✦ Une seule carte</span><span>↔ Chat en direct</span><span>▧ Inventaires visuels</span><span>↺ Sauvegardes incluses</span></div>
    <section class="editorial"><div class="section-heading"><p class="eyebrow">TOUT PART DU JOUEUR</p><h2>Le bon outil,<br />au bon endroit.</h2></div><div class="explanations"><article><span class="number">01</span><div><h3>Sélectionnez. Agissez.</h3><p>Un joueur à aider ? Sa fiche rassemble inventaire, objets, skin et permissions. Inutile de chercher une commande.</p></div></article><article><span class="number">02</span><div><h3>Un monde, une carte.</h3><p>Choisissez une construction ou une créature dans le tiroir, pointez un emplacement, vérifiez puis confirmez. Les joueurs restent visibles en direct.</p></div></article><article><span class="number">03</span><div><h3>La partie reste la priorité.</h3><p>Le chat arrive par un flux partagé. Le terrain de la carte se redessine par défaut quand personne ne joue. Les réglages avancés restent à portée de main.</p></div></article></div></section>
    <section class="showcase"><div><p class="eyebrow">UNE TOUCHE PERSONNELLE</p><h2>Un skin qui vous ressemble.<br />Un monde à votre idée.</h2><p>Parcourez les skins, regardez l’aperçu, puis appliquez votre choix. Donnez des objets avec leurs visuels. Importez vos fichiers <code>.schem</code> après vérification du terrain.</p><a class="text-link" href={`${base}/demo/`}>Prendre les commandes dans la démo ↗</a></div><img src={`${base}/screens/desktop-skins.jpg`} alt="Recherche et aperçu des skins dans une fiche joueur fictive." width="1440" height="1000" loading="lazy" /></section>
    <section class="mobile-section"><div class="phone"><img src={`${base}/screens/mobile-home.jpg`} alt="DuckCatMine sur téléphone : cinq onglets accessibles et une vue compacte." width="390" height="844" loading="lazy" /></div><div><p class="eyebrow">DEPUIS LE CANAPÉ AUSSI</p><h2>Votre serveur<br />tient dans la poche.</h2><p>Une navigation compacte, un chat accessible partout et une application installable sur l’écran d’accueil.</p><ul><li>Pas d’application à acheter.</li><li>Notifications Web Push sur les appareils compatibles.</li><li>Sur iPhone : installation à l’écran d’accueil et iOS 16.4 minimum.</li></ul><a class="text-link" href={`${base}/guides/notifications/`}>Configurer les notifications →</a></div></section>
    <section class="installation" id="installer"><div><p class="eyebrow">COMMENCER SIMPLEMENT</p><h2>Une commande.<br />Puis laissez-vous guider.</h2><p>Sur un VPS Ubuntu ou Debian neuf, l’assistant demande votre domaine, vos pseudos et un profil de ressources. Vous choisissez ensuite votre mot de passe dans le navigateur.</p><p class="release">Version alpha · sauvegardez vos données avant toute migration.</p></div><div class="install-box"><div class="terminal-label">TERMINAL DU VPS <button id="copy-install" type="button" aria-label="Copier la commande d’installation">Copier</button></div><pre><code id="install-command">{install}</code></pre><ol><li>Choisissez DuckDNS ou votre domaine.</li><li>Ajoutez les pseudos administrateurs.</li><li>Ouvrez votre lien d’activation privé.</li></ol><a class="text-link" href={`${base}/guides/installation/`}>Voir les prérequis et le guide complet →</a></div></section>
    <section class="budget"><div><p class="eyebrow">UN PETIT SERVEUR BIEN CHOISI</p><h2>Commencez petit.<br />Gardez de la marge.</h2></div><div class="budget-options"><article><p>01 / PETIT GROUPE</p><h3>4 Go RAM · 2 vCPU</h3><span>Profil Small · jusqu’à 6 places</span><p>Pour quelques amis et un monde raisonnable. Terrain rendu hors partie, distances réduites.</p></article><article><p>02 / PLUS DE CONFORT</p><h3>8 Go RAM · 4 vCPU</h3><span>Profil Friends · 10 places</span><p>Plus de marge pour explorer et construire ensemble. Un processeur rapide compte autant que la RAM.</p></article><a class="text-link" href={`${base}/guides/choisir-un-vps/`}>Comparer les offres et comprendre le budget →</a></div></section>
    <section class="closing"><img src={`${base}/logo.svg`} alt="" width="64" height="64" /><h2>Le prochain chapitre<br />de votre monde commence ici.</h2><a class="button primary" href={`${base}/demo/`}>Découvrir DuckCatMine ↗</a><p>Hébergé chez vous. Construit ensemble.</p></section>
  </main>
  <footer><a class="brand" href={`${base}/`}>DuckCatMine</a><span>Logiciel libre · GPL-3.0-or-later</span><a href={`${base}/guides/decouvrir/`}>Documentation</a><a href="https://github.com/drslid/DuckCatMine">Contribuer ↗</a><p>Projet indépendant, sans affiliation avec Mojang ou Microsoft.</p></footer>
  <script>
    document.querySelector('#copy-install')?.addEventListener('click', async event => {
      const button = event.currentTarget as HTMLButtonElement;
      try { await navigator.clipboard.writeText(document.querySelector('#install-command')!.textContent!); button.textContent = 'Copié ✓'; }
      catch { button.textContent = 'Sélectionnez la commande'; }
    });
  </script>
</body>
</html>
<style is:global>
  *{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:#111b16;color:#f1f2e9;font:16px/1.65 system-ui,-apple-system,sans-serif}a{color:inherit;text-decoration:none}button{font:inherit;cursor:pointer}a:focus-visible,button:focus-visible{outline:3px solid #c8e8a2;outline-offset:5px}img{max-width:100%;height:auto;display:block}header,main,footer{max-width:1320px;margin:auto}header{display:flex;align-items:center;justify-content:space-between;padding:28px 42px;gap:24px}.brand{display:flex;align-items:center;gap:10px;font-size:21px;font-weight:750;letter-spacing:-1px}.alpha{font-size:10px;letter-spacing:1px;text-transform:uppercase;border:1px solid #668168;border-radius:5px;padding:1px 5px;color:#bfcebf}nav{display:flex;align-items:center;gap:26px;font-size:13px}.nav-cta{background:#24372b;border:1px solid #405841;padding:10px 18px;border-radius:8px}.hero{padding:64px 42px 72px;display:grid;grid-template-columns:.85fr 1.15fr;gap:42px;align-items:center}.eyebrow{font-size:10px;font-weight:700;letter-spacing:2px;color:#b8c8b7;margin:0 0 22px;display:flex;align-items:center;gap:9px}.eyebrow span{height:7px;width:7px;border-radius:50%;background:#c7e59e}h1,h2,h3,p{margin-top:0}h1{font-size:clamp(48px,4.4vw,68px);line-height:1.08;letter-spacing:-3.7px;font-weight:650;margin-bottom:26px}h1 em{font-family:Georgia,serif;font-weight:400;color:#d7ebbc}h2{font-size:clamp(31px,3.4vw,46px);font-weight:550;line-height:1.17;letter-spacing:-2px}h3{font-size:20px;font-weight:600;letter-spacing:-.6px;margin-bottom:8px}.lead{font-size:16px;line-height:1.8;color:#b7c2b7;max-width:410px}.actions{display:flex;gap:10px;flex-wrap:wrap;margin:30px 0 20px}.button{display:inline-flex;align-items:center;justify-content:center;gap:20px;padding:12px 19px;border-radius:8px;font-size:12px;font-weight:700;transition:background .15s}.button:hover{filter:brightness(1.1)}.primary{background:#d3e9b5;color:#17271c}.secondary{border:1px solid #49624e;background:#1d2c22}.fine{font-size:10px;color:#8eaa94;line-height:1.9}.hero-screen{margin:0;min-width:0;border:1px solid #3e5143;border-radius:13px;overflow:hidden;box-shadow:0 28px 75px #030d0866;background:#18261d;transform:rotate(-1deg)}.browser-bar{display:flex;justify-content:space-between;padding:10px 14px;font-size:9px;color:#6c8d76}.browser-bar small{font-size:9px;color:#a4baa9}.hero-screen img{width:100%;aspect-ratio:1.44;object-fit:cover}.hero-screen figcaption{font-size:9px;text-align:center;padding:8px;color:#a1b3a4}.feature-strip{margin:0 42px;display:flex;justify-content:space-between;gap:16px;padding:26px 0;border-top:1px solid #304236;border-bottom:1px solid #304236;font-size:12px;color:#b9c6b9}.editorial{display:grid;grid-template-columns:1fr 1fr;gap:90px;padding:100px 68px}.explanations article{display:flex;gap:26px;margin-bottom:30px}.explanations article:last-child{margin:0}.number{font:12px/2.5 ui-monospace,monospace;color:#93b18c}.explanations p,.showcase p,.mobile-section p,.installation p,.budget p{color:#a9beae;font-size:14px;line-height:1.85}.showcase{border-radius:20px;background:#1b2a20;border:1px solid #354c3b;padding:46px 0 0 46px;display:grid;grid-template-columns:.75fr 1.25fr;gap:42px;overflow:hidden;margin:0 42px}.showcase>div{padding-bottom:40px}.showcase img{align-self:end;border-radius:12px 0 0 0;border:1px solid #4c6350;box-shadow:0 8px 30px #0004;object-fit:cover;height:100%}.showcase h2{font-size:31px;letter-spacing:-1.4px}.text-link{font-size:12px;font-weight:650;color:#d3e9b5;display:inline-block;margin-top:12px}.mobile-section{padding:100px 120px;display:grid;grid-template-columns:310px 1fr;align-items:center;gap:110px}.phone{max-width:240px;justify-self:center;border:7px solid #344b3d;outline:1px solid #6c7f6e;border-radius:36px;overflow:hidden;box-shadow:0 28px 80px #0004;transform:rotate(-3deg)}.phone img{width:100%}.mobile-section ul{padding-left:18px;font-size:13px;color:#bdcabe;line-height:2}.installation{padding:65px 42px;display:grid;grid-template-columns:1fr 1fr;gap:80px;border-top:1px solid #304236;border-bottom:1px solid #304236;margin:0 42px}.installation .release{font-size:11px;color:#c9bda6}.install-box{background:#0b140f;border:1px solid #3d5343;border-radius:12px;padding:24px;align-self:center;min-width:0}.terminal-label{display:flex;align-items:center;justify-content:space-between;color:#849e89;font:10px ui-monospace,monospace;letter-spacing:1px}.terminal-label button{background:#253d2b;color:#d6e7cc;border:1px solid #3a5741;border-radius:6px;padding:5px 10px;font-size:10px}pre{white-space:pre-wrap;overflow-wrap:anywhere;color:#d7edb8;font:12px/1.9 ui-monospace,monospace;margin:20px 0 25px}.install-box ol{padding-left:20px;color:#a9beae;font-size:12px;line-height:2}.budget{padding:90px 84px;display:grid;grid-template-columns:1fr 1fr;gap:80px}.budget-options article{padding:0 0 20px;border-bottom:1px solid #304236;margin-bottom:22px}.budget-options article>p:first-child{font-size:9px;letter-spacing:1.5px;color:#89a98d;margin-bottom:10px}.budget-options article>span{font-size:11px;color:#d0ddc8}.budget-options article>p:last-child{font-size:12px;margin:12px 0 0}.closing{text-align:center;padding:65px 20px 85px;background:radial-gradient(ellipse at 50% 70%,#2d48314d,transparent 65%)}.closing>img{margin:0 auto 24px}.closing h2{margin-bottom:30px}.closing p{font-size:11px;color:#98b09c;margin:18px 0 0}footer{border-top:1px solid #304236;padding:30px 42px;display:flex;flex-wrap:wrap;align-items:center;gap:24px;font-size:11px;color:#a7b9a9}footer .brand{font-size:17px;margin-right:auto}footer p{width:100%;font-size:10px;color:#698770}.skip{position:absolute;left:20px;top:-100px}.skip:focus{top:10px;background:#111b16;padding:12px;z-index:10}::selection{background:#d3e9b5;color:#142118}
  @media(max-width:1000px){header{padding:24px}.hero{padding:40px 24px;gap:24px;grid-template-columns:1fr}h1{font-size:60px}.intro{max-width:700px}.hero-screen{transform:none}.feature-strip{margin:20px 24px;flex-wrap:wrap}.editorial{padding:60px 24px;gap:40px}.showcase{margin:0 24px;padding:28px 0 0 28px;gap:25px}.mobile-section{padding:70px 50px;gap:50px;grid-template-columns:220px 1fr}.installation{margin:0 24px;padding:40px 0;gap:36px}.budget{padding:60px 24px;gap:40px}}
  @media(max-width:600px){header{padding:18px;gap:10px}.brand{font-size:17px;gap:7px}.brand img{width:28px;height:28px}.alpha{font-size:8px}nav{gap:12px;font-size:11px}nav>a:first-child{display:none}.nav-cta{padding:7px 10px}.hero{padding:38px 18px;gap:30px}h1{font-size:49px;letter-spacing:-2.8px}.eyebrow{font-size:8px;letter-spacing:1.5px}.lead{font-size:14px}.button{font-size:11px;padding:12px 15px;gap:12px}.feature-strip{margin:0 18px;font-size:10px;display:grid;grid-template-columns:1fr 1fr;gap:12px}.editorial{grid-template-columns:1fr;padding:55px 22px;gap:20px}.editorial h2 br{display:none}h2{font-size:34px;letter-spacing:-1.5px}.showcase{display:block;margin:0 18px;padding:24px 0 0 24px;border-radius:14px}.showcase>div{padding:0 24px 25px 0}.showcase img{height:auto}.mobile-section{grid-template-columns:1fr;gap:40px;padding:60px 26px}.phone{max-width:210px}.mobile-section>div:last-child{order:-1}.installation{grid-template-columns:1fr;margin:0 18px;padding:45px 0;gap:20px}.install-box{padding:20px}.budget{grid-template-columns:1fr;padding:50px 24px;gap:18px}.closing{padding:25px 22px 65px}footer{padding:24px 18px;gap:14px}footer .brand{width:100%}p{overflow-wrap:break-word}}
  @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.button{transition:none}}
</style>
